{
  "name": "hellemyrfau",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:preview-api": "node scripts/build.mjs --preview-api",
    "build:production": "node scripts/build.mjs --production",
    "build:local": "node scripts/build.mjs --local",
    "dev:api": "wrangler dev --env local",
    "db:local": "wrangler d1 migrations apply DB --local --env local",
    "check:worker": "wrangler deploy --env '' --dry-run --outdir build/worker",
    "deploy:worker": "wrangler deploy --env ''",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "jose": "6.2.17"
  },
  "devDependencies": {
    "wrangler": "4.162.0"
  }
}
